#!/bin/sh
# Maven Wrapper script para Linux/Mac
# ----------------------------------------------------------------------------
# Licensed to the Apache Software Foundation (ASF)
# ----------------------------------------------------------------------------

if [ -z "$JAVA_HOME" ] ; then
  JAVACMD=`which java`
else
  JAVACMD="$JAVA_HOME/bin/java"
fi

MAVEN_PROJECTBASEDIR="${MAVEN_BASEDIR:-$(pwd)}"
MAVEN_WRAPPER_JAR="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar"
MAVEN_WRAPPER_PROPERTIES="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties"

# Baixa o wrapper jar se não existir
if [ ! -f "$MAVEN_WRAPPER_JAR" ]; then
  DOWNLOAD_URL=$(grep "wrapperUrl" "$MAVEN_WRAPPER_PROPERTIES" | cut -d= -f2)
  echo "Baixando Maven Wrapper de: $DOWNLOAD_URL"
  if command -v curl > /dev/null; then
    curl -o "$MAVEN_WRAPPER_JAR" "$DOWNLOAD_URL" -s
  elif command -v wget > /dev/null; then
    wget "$DOWNLOAD_URL" -O "$MAVEN_WRAPPER_JAR"
  fi
fi

exec "$JAVACMD" \
  -classpath "$MAVEN_WRAPPER_JAR" \
  "-Dmaven.multiModuleProjectDirectory=$MAVEN_PROJECTBASEDIR" \
  org.apache.maven.wrapper.MavenWrapperMain "$@"
